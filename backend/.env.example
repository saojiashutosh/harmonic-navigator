DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_TIME_ZONE=UTC

DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

DJANGO_OPTIONAL_APPS=
DJANGO_STATIC_ROOT=staticfiles

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
FIREBASE_ADMIN_CREDENTIALS=./serviceAccountKey.json
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=IN

# Groq AI (free) — used as a mood-inference fallback when rule-based confidence is low.
# Free API key at https://console.groq.com (no credit card required).
# Leave blank to disable AI fallback (system still works without it).
GROQ_API_KEY=

# Concert Mode — upcoming-concert detection and setlist-weighted playlists.
# Live discovery scrapes AllEvents' public city pages in real time — no API
# key required. If the site's URL scheme changes, override it:
#   CONCERT_EVENTS_URL=https://allevents.in/{slug}/music
# setlist.fm API (free): request a key at https://www.setlist.fm/settings/api
# Optional — without SETLISTFM_API_KEY playlists still build from the catalog.
SETLISTFM_API_KEY=
