# Production env (Hugging Face Spaces / docker-compose.yaml).
# Copy to .env.prod for local prod-parity runs. On HF, set each of these as a
# Space *Secret* instead of committing this file.

DJANGO_SETTINGS_MODULE=core.settings.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=generate-a-long-random-50+-char-string

# HF gives the Space a host like <user>-<space>.hf.space. Allow that + the
# wildcard so the embedded preview domain works too.
DJANGO_ALLOWED_HOSTS=.hf.space,localhost,127.0.0.1
# Must be full https origins (scheme included): your HF Space + Vercel domain.
DJANGO_CSRF_TRUSTED_ORIGINS=https://<user>-<space>.hf.space,https://<your-app>.vercel.app

# --- Neon Postgres ---
# From the Neon dashboard connection string. Neon REQUIRES TLS.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=neondb
DB_USER=<neon-user>
DB_PASSWORD=<neon-password>
DB_HOST=<your-endpoint>.neon.tech
DB_PORT=5432
DB_SSL_MODE=require

# --- Upstash Redis (TLS -> rediss://) ---
# Cache + Channels layer both read REDIS_URL. Use the `rediss://` URL from the
# Upstash console (NOT the REST URL).
REDIS_URL=rediss://default:<upstash-password>@<your-db>.upstash.io:6379

# --- Integrations (optional) ---
GROQ_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=IN
SETLISTFM_API_KEY=
