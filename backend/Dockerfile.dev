FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# ffmpeg: required so librosa/audioread can decode JioSaavn's AAC/.mp4
# audio streams (libsndfile alone cannot read AAC). dos2unix normalises any
# CRLF line endings in scripts copied from a Windows checkout.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libsndfile1 ffmpeg dos2unix ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# Dev uses the ASGI runserver (the `daphne` app in INSTALLED_APPS swaps it in,
# so WebSockets work) with autoreload. docker-compose-dev.yaml overrides this
# command to add the migrate + Excel-seed bootstrap.
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
