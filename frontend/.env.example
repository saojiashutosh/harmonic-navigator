# Frontend build-time config (Vite inlines VITE_* vars at build).
#
# Leave UNSET for local dev — api.js then uses same-origin paths and Vite's dev
# proxy forwards them to Django (see vite.config.js).
#
# For the Vercel production build, set VITE_API_URL to your Hugging Face Space
# origin (no trailing slash). Both REST calls and the group-lobby WebSocket
# derive from it.
VITE_API_URL=https://<user>-<space>.hf.space
